platform :ios, '14.1'

target 'iosApp' do
  use_frameworks!
  pod 'ComposeApp', :path => '../composeApp'
  pod 'GoogleMaps'
  pod 'FirebaseCore',      '~> 11.0'
  pod 'FirebaseAuth',      '~> 11.0'
  pod 'FirebaseFirestore', '~> 11.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.1'
      config.build_settings['OTHER_LDFLAGS'] = '$(inherited) -ObjC'
    end
  end

  # ✅ Parchear BoringSSL directo en el proyecto pbxproj
  installer.pods_project.targets.each do |target|
    if target.name == 'BoringSSL-GRPC'
      target.build_configurations.each do |config|
        # Limpiar flags problemáticos de Apple Clang
        flags = config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
        config.build_settings['OTHER_CFLAGS'] = flags
          .gsub(/-G(?!CC)[^\s]*/, '')
          .strip

        cplus = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cplus
          .gsub(/-G(?!CC)[^\s]*/, '')
          .strip
      end

      # Parchear flags por archivo
      target.source_build_phase.files.each do |file|
        next unless file.settings
        next unless file.settings['COMPILER_FLAGS']
        fixed = file.settings['COMPILER_FLAGS']
          .gsub(/-G(?!CC)[^\s]*/, '')
          .strip
        file.settings['COMPILER_FLAGS'] = fixed
      end
    end
  end

  # Guardar cambios
  installer.pods_project.save
end