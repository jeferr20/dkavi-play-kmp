CREATE TABLE UsuarioTable(
    usuarioUid TEXT NOT NULL PRIMARY KEY,
    usuario TEXT NOT NULL,
    rango TEXT NOT NULL,
    puntos INTEGER NOT NULL,
    partidasGanadas INTEGER NOT NULL,
    partidasJugadas INTEGER NOT NULL,
    urlImagen TEXT,
    rol TEXT NOT NULL,
    inventarioJson TEXT,
    genero TEXT NOT NULL,
    departamento TEXT NOT NULL,
    distrito TEXT NOT NULL,
    provincia TEXT NOT NULL,
    sedePreferencia TEXT NOT NULL,
    horariosJson TEXT NOT NULL,
    monedas INTEGER NOT NULL
);

CREATE TABLE PersonaTable(
    personaUid TEXT NOT NULL PRIMARY KEY,
    nombres TEXT NOT NULL,
    apellidoPaterno TEXT NOT NULL,
    apellidoMaterno TEXT NOT NULL,
    celular TEXT NOT NULL,
    correo TEXT NOT NULL
);

insertUsuarioTable:
INSERT OR REPLACE INTO UsuarioTable
VALUES ?;

insertPersonaTable:
INSERT OR REPLACE INTO PersonaTable
VALUES ?;

getUsuarioTable:
SELECT * FROM UsuarioTable LIMIT 1;

getPersonaTable:
SELECT * FROM PersonaTable LIMIT 1;

removeUsuarioTable:
DELETE FROM UsuarioTable;

removePersonaTable:
DELETE FROM PersonaTable;